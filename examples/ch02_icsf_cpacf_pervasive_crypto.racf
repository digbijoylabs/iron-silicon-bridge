/* ICSF Parmlib Configuration Member CSFPRM00 */
DOMAIN(0)           /* LPAR Crypto Domain */
CKDSN(CSF.PROD.CSFCKDS)   /* Symmetric Keys */
PKDSN(CSF.PROD.CSFPKDS)   /* Asymmetric Keys */
TKDSN(CSF.PROD.CSFTKDS)   /* PKCS#11 Tokens */
COMPAT(NO)          /* Disable legacy compat */
SSM(YES)            /* Enable Secure Mode */
KEYAUTH(YES)        /* Validate tokens via MAC */
CHECKAUTH(YES)      /* Mandate RACF checks */
MASTERKCVLEN(7)     /* MKVP length */
/* Audit all key lifecycle events */
AUDITKEYLIFECKDS(TOKEN(YES),LABEL(YES))

/* 1. Define the Encryption Key in RACF and ICSF */
RDEFINE CSFKEYS AI.TRAIN.DS.KEY UACC(NONE)
PERMIT AI.TRAIN.DS.KEY CLASS(CSFKEYS) ID(STGPOL) ACCESS(READ)

/* 2. Bind Key Label to VSAM Dataset Profile via DFP */
ADDSD 'PROD.AI.TRAINING.DATA.**' UACC(NONE)
ALTDSD 'PROD.AI.TRAINING.DATA.**' DFP(DATAKEY(AI.TRAIN.DS.KEY))
