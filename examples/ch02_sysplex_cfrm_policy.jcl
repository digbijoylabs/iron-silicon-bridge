//DEFINE   EXEC PGM=IXCMIAPU
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DATA TYPE(CFRM) REPORT(YES)
  
  DEFINE POLICY NAME(POL1) REPLACE(YES)
  
  /* Define the DB2 Lock Structure */
  STRUCTURE NAME(DB2_LOCK1)
    SIZE(1024M)
    INITSIZE(512M)
    PREFLIST(CF01,CF02)
    DUPLEX(ALLOWED)
    REBUILDPERCENT(1)
    
  /* Define the DB2 Group Buffer Pool */
  STRUCTURE NAME(DB2_GBP0)
    SIZE(2048M)
    INITSIZE(1024M)
    PREFLIST(CF01,CF02)
    DUPLEX(ALLOWED)

DEFINE POLICY NAME(SFMPOL1) 
  SYSTEM NAME(*)
    ISOLATETIME(0)
    RESETTIME(10)
