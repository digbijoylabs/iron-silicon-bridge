//ALLOCVSM EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DEFINE CLUSTER -
    (NAME(PROD.AI.TRAINING.DATA.CLUSTER) -
     INDEXED -
     KEYS(10 0) -
     RECORDSIZE(100 150) -
     CYLINDERS(500 50) -
     DATACLASS(ENCRYPT) -   /* DFSMS enforces encryption */
     SHAREOPTIONS(2 3)) -
  DATA -
    (NAME(PROD.AI.TRAINING.DATA.CLUSTER.DATA)) -
  INDEX -
    (NAME(PROD.AI.TRAINING.DATA.CLUSTER.INDEX))
/*
